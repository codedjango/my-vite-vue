{
  "name": "my-vite-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt check",
    "fmt:init": "oxfmt --init",
    "typecheck": "vue-tsc --noEmit",
    "format": "pnpm run lint:fix && pnpm run fmt && pnpm run typecheck"
  },
  "dependencies": {
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.3"
  }
}
